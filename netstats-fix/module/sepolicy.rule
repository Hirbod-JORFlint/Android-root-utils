# === netproxy (our native binary) permissions ===
allow * proc_net:file { read open getattr };
allow * binder_device:chr_file { read write open ioctl };
allow * binder:service_manager { find add };

# === bpfloader permissions (fix Axion OS denials) ===
allow init bpfloader_exec:file { getattr open read execute execute_no_trans };
allow bpfloader bpffs:dir { search read write add_name remove_name };
allow bpfloader bpffs:file { create read write open map };
allow bpfloader self:capability { sys_ptrace };

# === netd permissions for BPF maps ===
allow netd bpffs:dir { search read };
allow netd bpffs:file { read write open map getattr };
allow netd self:capability { sys_admin };

# === SystemUI / system_app reading /proc/net/dev ===
allow system_app proc_net:file { read open getattr };
allow platform_app proc_net:file { read open getattr };

# === xt_qtaguid fallback (legacy) ===
allow netd qtaguid_device:chr_file { read write open ioctl };
allow system_app qtaguid_device:chr_file { read write open ioctl };

# === Magisk module context permissions ===
allow magisk proc_net:file { read open getattr };
allow magisk binder_device:chr_file { read write open ioctl };
allow magisk binder:service_manager { find add };
