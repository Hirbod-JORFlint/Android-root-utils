# === netproxy (our native binary) permissions ===
allow * proc_net:file { read open getattr };
allow * proc_net:dir { read search open };
allow * binder_device:chr_file { read write open ioctl };
allow * servicemanager:service_manager { find add };
allow * service_manager_service:service_manager { find add };
allow * netd:fd use;
allow * netd_socket:sock_file write;
allow * sysfs_bpf:file { read open getattr };
allow * sysfs_bpf:dir { read search open };

# === SystemUI / system_app reading /proc/net/dev ===
allow system_app proc_net:file { read open getattr };
allow system_app proc_net:dir { read search open };
allow platform_app proc_net:file { read open getattr };
allow platform_app proc_net:dir { read search open };

# === bpfloader execution (all possible contexts) ===
allow init bpfloader_exec:file { getattr open read execute execute_no_trans };
allow init bpfloader_platform_exec:file { getattr open read execute execute_no_trans };
allow init apex_file:file { getattr open read execute execute_no_trans };
allow init apex_exec:file { getattr open read execute execute_no_trans };
allow init system_file:file { getattr open read execute execute_no_trans };

# === bpfloader SELinux domain permissions ===
allow bpfloader self:capability { sys_ptrace sys_admin net_admin };
allow bpfloader self:capability2 { sys_ptrace sys_admin };
allow bpfloader kernel:system module_request;
allow bpfloader bpffs:dir { search read write add_name remove_name create rmdir setattr };
allow bpfloader bpffs:file { create read write open map getattr setattr unlink };
allow bpfloader bpffs:lnk_file { read open getattr };
allow bpfloader selinuxfs:file { read open getattr };
allow bpfloader proc_net:file { read open getattr };
allow bpfloader proc_net:dir { search read };
allow bpfloader proc_kallsyms:file { read open getattr };
allow bpfloader kmsg_device:chr_file { write };
allow bpfloader sysfs_btf:file { read open getattr };
allow bpfloader sysfs_btf:dir { search read };
allow bpfloader sysfs:file { read open getattr };
allow bpfloader sysfs:dir { search read };
allow bpfloader tmpfs:file { read write open };
allow bpfloader tmpfs:dir { search read write add_name create };
allow bpfloader unlabeled:dir { search read };
allow bpfloader unlabeled:file { read open getattr };

# === netd permissions for BPF maps ===
allow netd self:capability { sys_admin net_admin };
allow netd kernel:system module_request;
allow netd bpffs:dir { search read write add_name remove_name create rmdir };
allow netd bpffs:file { read write open map getattr setattr };
allow netd bpffs:lnk_file { read open getattr };
allow netd proc_net:file { read open getattr };
allow netd proc_net:dir { search read };

# === system_server permissions for BPF/proc_net ===
allow system_server self:capability { sys_admin };
allow system_server bpffs:dir { read search open };
allow system_server bpffs:file { read open getattr map };
allow system_server bpffs:lnk_file { read open getattr };
allow system_server proc_net:file { read open getattr };
allow system_server proc_net:dir { read search open };
allow system_server sysfs_bpf:file { read open getattr };
allow system_server sysfs_bpf:dir { read search open };

# === xt_qtaguid fallback (legacy) ===
allow netd qtaguid_device:chr_file { read write open ioctl };
allow system_app qtaguid_device:chr_file { read write open ioctl };
allow platform_app qtaguid_device:chr_file { read write open ioctl };
allow netd socket_device:sock_file { read write create open };
allow system_app socket_device:sock_file { read write open };
allow platform_app socket_device:sock_file { read write open };

# === Magisk module context permissions ===
allow magisk proc_net:file { read open getattr };
allow magisk proc_net:dir { read search open };
allow magisk binder_device:chr_file { read write open ioctl };
allow magisk servicemanager:service_manager { find add };
allow magisk service_manager_service:service_manager { find add };
allow magisk sysfs_bpf:file { read open getattr };
allow magisk sysfs_bpf:dir { read search open };

# === system_background for stats collection ===
allow system_background proc_net:file { read open getattr };
allow system_background proc_net:dir { read search open };

# === crash_dump / dumpstate (for diagnostics) ===
allow crash_dump bpfloader:process { ptrace };
allow dumpstate bpfloader:process { ptrace };

# === Shell / ADB ===
allow shell proc_net:file { read open getattr };
allow shell proc_net:dir { read search open };

# === allow all domains to read /proc/net/dev (broad but safe) ===
allow domain proc_net:file { read open getattr };
allow domain proc_net:dir { read search open };
allow domain bpffs:file { read open getattr map };
allow domain bpffs:dir { read search open };
