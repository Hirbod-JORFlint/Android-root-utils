allow init bpfloader_exec:file { getattr open read execute execute_no_trans };
allow bpfloader bpffs:dir { search read write add_name remove_name };
allow bpfloader bpffs:file { create read write open map };
allow system_app proc_net:file { read open getattr };
allow netd qtaguid_device:chr_file { read write open ioctl };
allow bpfloader self:capability { sys_ptrace };
