# sepolicy.rule - SELinux policy patches for netstats-fix module
# These rules fix denials observed across multiple devices and kernels

# ---- bpfloader needs sysfs access for BPF map sizing ----
allow bpfloader sysfs_mm dir search;
allow bpfloader sysfs_mm file read;

# ---- bpfloader needs to access kernel symbols ----
allow bpfloader kernel kernel { syslog };

# ---- bpfloader needs to create and pin BPF maps ----
allow bpfloader fs_bpf dir { search create write read };
allow bpfloader fs_bpf file { create write read };

# ---- bpfloader needs to load BPF programs ----
allow bpfloader bpf { map_create prog_load };

# ---- bpfloader needs to create netd_shared directory ----
allow bpfloader fs_bpf dir create;
allow bpfloader fs_bpf dir write;

# ---- netd needs to read BPF maps ----
allow netd fs_bpf dir search;
allow netd fs_bpf file read;
allow netd bpf map read;
allow netd bpf map get_info_by_fd;

# ---- init needs to restart bpfloader ----
allow init bpfloader service { find };

# ---- netd needs sysfs access for stats ----
allow netd sysfs file { read open };
allow netd sysfs dir { search open read };

# ---- allow bpfloader to execute through init ----
allow init bpfloader_exec file execute_no_trans;
