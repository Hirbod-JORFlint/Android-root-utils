# sepolicy.rule - SELinux policy patches for netstats-fix module
# These rules fix denials observed across multiple devices and kernels
#
# Key insight: netd needs to access BPF maps pinned at /sys/fs/bpf/netd_shared/
# to initialize per-UID stats. Without these permissions, netd's BpfNetMapsUtils
# reports "Firewall unavailable, ignoring BPF" and falls back to legacy iptables.

# ---- bpfloader needs to create and pin BPF maps ----
# bpfloader (netbpfload) runs as root and creates the BPF maps/programs
allow bpfloader fs_bpf dir { search create write read add_name remove_name };
allow bpfloader fs_bpf file { create write read open getattr ioctl map_create };

# ---- bpfloader needs BPF syscall access ----
allow bpfloader bpf { map_create prog_load map_read map_write };

# ---- bpfloader needs sysfs access for map sizing ----
allow bpfloader sysfs_mm dir { search read };
allow bpfloader sysfs_mm file { read open };

# ---- bpfloader needs to read kernel symbols for BPF loading ----
allow bpfloader kernel kernel { syslog read };

# ---- bpfloader needs to execute through init ----
allow init bpfloader service { find };
allow init bpfloader_exec file { execute_no_trans execute read open getattr };

# ---- netd needs to read BPF maps ----
# This is the CRITICAL fix: netd's BpfNetMapsUtils opens these maps to
# initialize per-UID stats and BPF firewall chains. Without read access,
# it logs "Firewall unavailable, ignoring BPF" and stats collection fails.
allow netd fs_bpf dir { search read open };
allow netd fs_bpf file { read open getattr ioctl map_read };

# ---- netd needs to read BPF programs (for attachment) ----
allow netd bpf prog { run };
allow netd bpf map { read write };

# ---- netd needs to write to BPF maps (for stats updates) ----
allow netd bpf map { update_elem get_elem };

# ---- netd needs to manage BPF program attachments ----
allow netd bpf map { get_next_key };

# ---- netd needs sysfs access for network stats ----
allow netd sysfs file { read open };
allow netd sysfs dir { search read open };

# ---- netd needs net_bw_a group access (maps are owned by this group) ----
allow netd net_bw_a dir { search read open };
allow netd net_bw_a file { read open getattr };

# ---- netd needs to access /dev/kmsg for BPF error logging ----
allow netd kmsg_device file { write open };

# ---- init needs to restart bpfloader ----
allow init bpfloader service { find stop start };

# ---- Allow netd to access BPF cgroup attachments ----
# netd attaches BPF programs to cgroups for per-UID traffic accounting
allow netd cgroup_file { read write open getattr };

# ---- Allow netd to read /proc for network stats fallback ----
allow netd proc_net dir { search read open };
allow netd proc_net file { read open };
allow netd proc_qtaguid_stat file { read open };
allow netd proc_qtaguid_ctrl file { read open write };
